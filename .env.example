# --- App ---
APP_ENV=dev
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:////data/teambuilding.db

# --- Auth / JWT ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Redis / Queue ---
REDIS_URL=redis://redis:6379/0

# --- Email (SMTP) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Team Building <no-reply@teambuilding.local>"
SMTP_USE_TLS=false

# --- RAG / Vector DB (ChatRAG concierge, docs/CHAT-RAG.md) ---
QDRANT_URL=http://qdrant:6333
EMBEDDING_PROVIDER=local
# DashScope (Alibaba Cloud, Qwen) is the only LLM provider — its
# OpenAI-compatible tool-calling is what makes the chat tools work.
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-max-preview

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
